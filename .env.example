# Postgres 連線
PGVECTOR_URL=postgresql://finrag:finrag@localhost:5432/finrag

# Ollama 模型設定
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b
EMBEDDING_MODEL=bge-m3

# SEC EDGAR 規定 User-Agent 需含聯絡方式
SEC_USER_AGENT=finance-ai-assistant jason.chen.develop@gmail.com

# MCP server 的 Bearer 驗證 token；留空代表不啟用（本機開發用）
MCP_AUTH_TOKEN=

# Google 登入：Cloud Console > APIs & Services > Credentials
# callback 填 <CHAINLIT_URL>/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# 簽 session JWT 用，以 `chainlit create-secret` 產生
CHAINLIT_AUTH_SECRET=
# OAuth callback 的對外網址；本機開發用 http://localhost:8000
CHAINLIT_URL=http://localhost:8000

# 對話 thread 保存天數，超過自動清除（steps/elements/feedbacks 隨 thread 連帶清除）
THREAD_RETENTION_DAYS=90
